# kitty_grab_helix configuration. Copy to ~/.config/kitty/grab.conf and
# uncomment what you want to change. Nothing here needs a kitty reload: the
# file is read each time the kitten starts.
#
# Colours are #rgb or #rrggbb.

# selection_foreground #ffffff
# selection_background #5294e2
# cursor               #ad7fa8

# Characters that count as part of a word, on top of letters and digits.
# Empty takes kitty's own select_by_word_characters.
# select_by_word_characters @-./_~?&=%+#

# Keys are written as in kitty.conf (ctrl+u, alt+;, shift+x) or as in helix
# (C-u, A-;, X); a sequence is chords joined with > (g>g). `unmap <keys>`
# drops one binding and `clear_all_shortcuts` drops them all, so you can
# start from nothing.
#
# The default map, in full:

# map h        move_char_left
# map left     move_char_left
# map j        move_line_down
# map down     move_line_down
# map k        move_line_up
# map up       move_line_up
# map l        move_char_right
# map right    move_char_right
# map w        move_next_word_start
# map b        move_prev_word_start
# map e        move_next_word_end
# map W        move_next_long_word_start
# map B        move_prev_long_word_start
# map E        move_next_long_word_end
# map ctrl+b   move_page_up
# map pgup     move_page_up
# map ctrl+f   move_page_down
# map pgdn     move_page_down
# map ctrl+u   move_half_page_up
# map ctrl+d   move_half_page_down
# map g>g      goto_file_start
# map g>e      goto_last_line
# map g>h      goto_line_start
# map home     goto_line_start
# map g>l      goto_line_end
# map end      goto_line_end
# map g>s      goto_first_nonwhitespace
# map G        goto_line
# map v        select_mode
# map ctrl+v   columnar_mode
# map ;        collapse_selection
# map alt+;    flip_selections
# map x        extend_line_below
# map X        extend_to_line_bounds
# map %        select_all
# map ctrl+e   scroll_down
# map ctrl+y   scroll_up
# map y        yank
# map return   yank
# map escape   normal_mode
# map q        quit
